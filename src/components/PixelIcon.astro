---

<svg
  viewBox="0 0 8 8"
  class:list={["px-icon", className]}
  shape-rendering="crispEdges"
  fill="currentColor"
  aria-hidden="true"
>
  {pixels.map((row, y) => row.split("").map((glyph, x) => glyph === "X" ? <rect x={x} y={y} width="1" height="1" /> : null))}
</svg>
